digraph Gv2{     
graph [nodesep="0.3", ranksep="0.3",fontsize=12]
label="Cost: 0\nMax flow: 0";
labelloc=t;
node [shape=circle,fixedsize=true,width=.3,height=.3,fontsize=12]
edge [arrowsize=0.6]

s -> 1 [label = <<font color="blue">0/20</font>,<font color="red">0</font>>]
              s -> 2 [label = <<font color="blue">0/30</font>,<font color="red">0</font>>]
